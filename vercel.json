{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "content.saharali.com" }],
      "destination": "/content"
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "events.saharali.com" }],
      "destination": "/events"
    }
  ]
}
