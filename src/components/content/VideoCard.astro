---
import Icon from "../Icon.astro";
import type { VideoItem } from "../../data/creatorMedia";

interface Props {
  item: VideoItem;
}

const { item } = Astro.props;
const reelUrl = `https://www.instagram.com/reel/${item.reel}/`;
const poster = `/content/reels/${item.reel}.jpg`;
---

<article class="reel-card">
  <div class="reel-media">
    <a
        class="reel-play"
        href={reelUrl}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`Watch ${item.title} on Instagram`}
      >
        <img src={poster} alt={item.alt} loading="lazy" decoding="async" />
        <span class="reel-play-mark" aria-hidden="true"><Icon name="play" size={24} /></span>
      </a>

  </div>
</article>
