---
import Analytics from "@vercel/analytics/astro";
import "../styles/global.css";
import { posts } from "../data/posts";
import {
  consultationUrl,
  emailUrl,
  githubUrl,
  linkedinUrl,
  siteUrl,
} from "../data/links";

interface Props {
  title?: string;
  description?: string;
  type?: "website" | "article";
  publishedTime?: string;
}

const {
  title = "Sahar Ali | Tech Consultant | AI, Product & Delivery",
  description =
    "I help teams adapt to AI for productive work: coding agents, startups, large corporations, and small businesses. Also automation, product, delivery, and data.",
  type = "website",
  publishedTime,
} = Astro.props;

const hasBlog = posts.length > 0;
const canonical = new URL(Astro.url.pathname, siteUrl).href;
const ogImage = new URL("/og.jpg", siteUrl).href;
const ogImageAlt = "Sahar Ali homepage: I turn tech chaos into business results";
const jsonLdDescription =
  "Sahar Ali is a Dubai-based tech consultant. She helps teams adapt to AI for productive work, including coding agents, startups, large corporations, and AI transformations in small businesses. She also covers automation, product, delivery, and data.";

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Sahar Ali",
  jobTitle: "Tech Consultant",
  url: siteUrl,
  description: jsonLdDescription,
  address: {
    "@type": "PostalAddress",
    addressLocality: "Dubai",
    addressCountry: "AE",
  },
  sameAs: [linkedinUrl, githubUrl],
};

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  name: "Sahar Ali",
  url: siteUrl,
  description: jsonLdDescription,
  areaServed: "Worldwide",
  sameAs: [linkedinUrl, githubUrl],
  potentialAction: {
    "@type": "ReserveAction",
    name: "Book a consult",
    target: consultationUrl,
  },
};

const articleSchema = type === "article"
  ? {
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      headline: title.replace(" | Sahar Ali", ""),
      description,
      datePublished: publishedTime,
      author: {
        "@type": "Person",
        name: "Sahar Ali",
        url: siteUrl,
      },
      url: canonical,
      mainEntityOfPage: canonical,
    }
  : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Sahar Ali" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    {publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}
    <script type="application/ld+json" is:inline set:html={JSON.stringify(personSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(serviceSchema)} />
    {articleSchema && (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(articleSchema)} />
    )}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Space+Grotesk:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <Analytics />
  </head>
  <body>
    <div class="progress-bar" id="progressBar"></div>

    <nav class="nav">
      <a href="/" class="nav-logo">SAHAR<span class="spark">✦</span>ALI</a>
      <ul class="nav-links">
        <li><a href="/#services">Services</a></li>
        <li><a href="/#work">Work</a></li>
        <li><a href="/#quotes">Quotes</a></li>
        <li><a href="/#tools">Tools</a></li>
        {hasBlog && <li><a href="/blog">Blog</a></li>}
        <li class="nav-cta"><a href={consultationUrl} class="btn" target="_blank" rel="noopener noreferrer">Book a consult</a></li>
      </ul>
      <button class="nav-burger" id="navBurger" aria-label="Open menu" aria-expanded="false">
        <span></span>
        <span></span>
        <span></span>
      </button>
      <div class="mobile-menu" id="mobileMenu">
        <a href="/#services">Services</a>
        <a href="/#work">Work</a>
        <a href="/#quotes">Quotes</a>
        <a href="/#tools">Tools</a>
        {hasBlog && <a href="/blog">Blog</a>}
        <a href={consultationUrl} class="btn btn--pink" target="_blank" rel="noopener noreferrer">Book a consult ✦</a>
        <a href={emailUrl} class="btn">Contact me</a>
      </div>
    </nav>

    <main>
      <slot />
    </main>

    <footer class="footer">
      <span>© {new Date().getFullYear()} Sahar Ali · Dubai, UAE · working worldwide</span>
      <span class="footer-links">
        <a href={consultationUrl} target="_blank" rel="noopener noreferrer">Book a consult</a>
        <a href={emailUrl}>Contact me</a>
        <a href={linkedinUrl} target="_blank" rel="noopener noreferrer">LinkedIn</a>
        <a href={githubUrl} target="_blank" rel="noopener noreferrer">GitHub</a>
      </span>
    </footer>

    <script>
      // mobile menu
      const burger = document.getElementById("navBurger");
      const menu = document.getElementById("mobileMenu");
      burger?.addEventListener("click", () => {
        const open = menu?.classList.toggle("open");
        burger.setAttribute("aria-expanded", String(!!open));
        burger.classList.toggle("open", !!open);
      });
      menu?.querySelectorAll("a").forEach((a) =>
        a.addEventListener("click", () => {
          menu.classList.remove("open");
          burger?.classList.remove("open");
          burger?.setAttribute("aria-expanded", "false");
        })
      );

      // scroll progress bar
      const bar = document.getElementById("progressBar");
      const onScroll = () => {
        const max = document.documentElement.scrollHeight - window.innerHeight;
        if (bar) bar.style.width = `${(window.scrollY / max) * 100}%`;

        // hero sticker parallax: each drifts at its own rate
        document.querySelectorAll<HTMLElement>("[data-parallax]").forEach((el) => {
          const speed = parseFloat(el.dataset.parallax || "0");
          el.style.translate = `0 ${window.scrollY * speed}px`;
        });
      };
      window.addEventListener("scroll", onScroll, { passive: true });
      onScroll();

      // reveal-on-scroll
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add("visible");
              io.unobserve(e.target);
            }
          }
        },
        { threshold: 0.15 }
      );
      document.querySelectorAll(".reveal, .stagger").forEach((el) => io.observe(el));

      // animated counters
      const counterIO = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (!e.isIntersecting) continue;
            counterIO.unobserve(e.target);
            const el = e.target as HTMLElement;
            const target = parseInt(el.dataset.count || "0", 10);
            const suffix = el.dataset.suffix || "";
            const dur = 1400;
            const start = performance.now();
            const tick = (now: number) => {
              const p = Math.min((now - start) / dur, 1);
              const eased = 1 - Math.pow(1 - p, 3);
              el.textContent = Math.round(target * eased).toLocaleString() + suffix;
              if (p < 1) requestAnimationFrame(tick);
            };
            requestAnimationFrame(tick);
          }
        },
        { threshold: 0.5 }
      );
      document.querySelectorAll("[data-count]").forEach((el) => counterIO.observe(el));
    </script>
  </body>
</html>
