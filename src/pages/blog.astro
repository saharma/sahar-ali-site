---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import NewsletterForm from "../components/NewsletterForm.astro";
import { posts } from "../data/posts";
---

<Layout title="Blog | Sahar Ali" description="Straight talk on AI, product, delivery and working with developers, from tech consultant Sahar Ali.">
  <section class="hero" style="padding-bottom: 2rem;">
    <div class="wrap">
      <span class="section-tag reveal">The blog</span>
      <h1 class="section-title reveal" style="font-size: clamp(2.4rem, 6vw, 4.2rem);">
        Straight talk on <span class="highlight highlight--pink">tech</span>,<br />
        no <span class="highlight highlight--cyan">jargon</span> allowed
      </h1>
      <p class="hero-sub reveal">
        AI, product, delivery, data, and the fine art of getting business people and
        developers into the same conversation.
      </p>
    </div>
  </section>

  {posts.length > 0 && (
    <section style="padding-top: 1rem;">
      <div class="wrap">
        <div class="blog-grid stagger">
          {posts.map((p) => (
            <a class="blog-card" href={p.href}>
              <div class="blog-card-top">
                <span class="blog-icon"><Icon name={p.icon} size={40} /></span>
                <span class="read-time">{p.time}</span>
              </div>
              <div class="blog-card-body">
                <h3>{p.title}</h3>
                <p>{p.desc}</p>
                <span class="card-cta">{p.date} · Read it →</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="newsletter" style="padding-top: 3rem;">
    <div class="wrap">
      <h2 class="section-title reveal">Want these in your inbox?</h2>
      <p class="cta-sub reveal">
        No drip sequences. I'll send something when I have something worth sending.
      </p>
      <div class="reveal reveal--pop">
        <NewsletterForm />
      </div>
    </div>
  </section>
</Layout>
