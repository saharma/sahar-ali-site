---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";

const posts = [
  {
    icon: "message",
    time: "10 min read",
    date: "15 Aug 2026",
    href: "/blog/how-to-talk-to-developers",
    title: "How to talk to developers so they actually listen",
    desc: "You don't need to speak developer. Five habits — simplify in layers, hand over problems not solutions, define success, treat estimates as learning, and write bug reports that help.",
  },
  {
    icon: "lightbulb",
    time: "5 min read",
    date: "Coming soon",
    title: "Your business doesn't need an 'AI strategy'. It needs three automations.",
    desc: "Skip the 40-page strategy deck. Here's how to find the three workflows where AI will pay for itself this quarter — and the ones to leave alone.",
  },
  {
    icon: "rocket",
    time: "6 min read",
    date: "Coming soon",
    title: "0 to 300K users: what actually mattered",
    desc: "The unglamorous truth about scaling an AI product — and the three decisions that did 90% of the work.",
  },
  {
    icon: "wrench",
    time: "7 min read",
    date: "Coming soon",
    title: "I made my whole engineering org AI-first. Here's the playbook.",
    desc: "Claude Code, Cursor, Copilot, automated branching and testing — what worked, what flopped, and what I'd do differently.",
  },
  {
    icon: "pie",
    time: "5 min read",
    date: "Coming soon",
    title: "Your dashboard is lying to you",
    desc: "Most BI setups measure what's easy, not what matters. How to tell the difference before you make a decision you regret.",
  },
  {
    icon: "clock",
    time: "4 min read",
    date: "Coming soon",
    title: "Why your project is late (it's not the developers)",
    desc: "A decade of delivery post-mortems, one pattern. The real reasons deadlines slip — and the governance that catches them early.",
  },
];
---

<Layout title="Blog — Sahar Ali" description="Straight talk on AI, product, delivery and working with developers, from tech consultant Sahar Ali.">
  <section class="hero" style="padding-bottom: 2rem;">
    <div class="wrap">
      <span class="section-tag reveal">The blog</span>
      <h1 class="section-title reveal" style="font-size: clamp(2.4rem, 6vw, 4.2rem);">
        Straight talk on <span class="highlight highlight--pink">tech</span>,<br />
        no <span class="highlight highlight--cyan">jargon</span> allowed
      </h1>
      <p class="hero-sub reveal">
        AI, product, delivery, data, and the fine art of getting business people and
        developers into the same conversation. First post is live — more on the way.
      </p>
    </div>
  </section>

  <section style="padding-top: 1rem;">
    <div class="wrap">
      <div class="blog-grid stagger">
        {posts.map((p) => {
          const Tag = p.href ? "a" : "div";
          return (
            <Tag class="blog-card" href={p.href}>
              <div class="blog-card-top">
                <span class="blog-icon"><Icon name={p.icon} size={40} /></span>
                <span class="read-time">{p.time}</span>
              </div>
              <div class="blog-card-body">
                <h3>{p.title}</h3>
                <p>{p.desc}</p>
                <span class="fake-link">{p.href ? `${p.date} · Read it →` : `${p.date} ✦`}</span>
              </div>
            </Tag>
          );
        })}
      </div>
    </div>
  </section>

  <section class="cta" style="padding-top: 3rem;">
    <div class="wrap">
      <h2 class="section-title reveal">Want these in your inbox?</h2>
      <p class="cta-sub reveal">
        No newsletter yet — but say hi and you'll be first to know when it exists.
      </p>
      <div class="reveal reveal--pop">
        <a href="mailto:saharmohdali@gmail.com" class="btn btn--big">Say hi ✦</a>
      </div>
    </div>
  </section>
</Layout>
