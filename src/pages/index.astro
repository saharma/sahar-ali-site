---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import NewsletterForm from "../components/NewsletterForm.astro";
import { posts } from "../data/posts";
import { tools } from "../data/tools";
import { testimonials } from "../data/testimonials";
import { work } from "../data/work";
import { consultationUrl, emailUrl } from "../data/links";

export const prerender = false;

if (new URL(Astro.request.url).hostname === "content.saharali.com") {
  return Astro.redirect("/content/", 307);
}

const marqueeItems = [
  "AI Strategy",
  "Automation",
  "Product Management",
  "Delivery",
  "Data Analytics",
  "Dev Team Leadership",
  "LLM Apps",
  "Agentic Workflows",
];

const services = [
  {
    icon: "bot",
    bg: "var(--pink)",
    tag: "Most wanted",
    title: "AI That Actually Ships",
    desc: "LLM apps, RAG pipelines, agentic workflows, MCP integrations: built and shipped, not just slide-decked. I prototype hands-on with Claude and GPT APIs daily, so you get working software, fast.",
  },
  {
    icon: "zap",
    bg: "var(--yellow)",
    tag: "",
    title: "Automation & Ops",
    desc: "Kill the busywork. I find the repetitive processes eating your team's week and replace them with automations: Zapier, Make, custom agents, service-desk bots, the lot.",
  },
  {
    icon: "compass",
    bg: "var(--cyan)",
    tag: "",
    title: "Product Management",
    desc: "Vision, roadmap, discovery, ruthless prioritisation. I've owned 30+ products end to end and scaled one from zero to 300K users. Your idea becomes a plan; your plan becomes a product.",
  },
  {
    icon: "truck",
    bg: "var(--lime)",
    tag: "",
    title: "Delivery & Programme Mgmt",
    desc: "Agile, hybrid, waterfall: whatever gets it shipped. Sprint planning, RAID, change control, exec reporting, vendor wrangling. Deadlines stop being fictional.",
  },
  {
    icon: "code",
    bg: "var(--purple)",
    tag: "",
    title: "Engineering Team Leadership",
    desc: "I speak developer fluently. I help teams adapt to AI for real work: Jira MCPs, Cursor, Claude Code, Copilot. That covers startups, large corporations, and AI transformations in small businesses. The aim is productive use.",
  },
  {
    icon: "chart",
    bg: "var(--orange)",
    tag: "",
    title: "Data & Analytics",
    desc: "SQL, ETL, warehousing, BI dashboards. From eBay to Dubai's RTA, I've turned messy data into decisions people actually make. Your numbers should work as hard as you do.",
  },
];

---

<Layout
  description="I help teams adapt to AI for productive work: coding agents, startups, large corporations, and small businesses. Also automation, product, delivery, and data."
>
  <!-- HERO -->
  <section class="hero">
    <div class="wrap hero-inner">
      <svg class="hero-star" viewBox="0 0 100 100" data-parallax="0.08" aria-hidden="true">
        <polygon
          points="50,0 61,35 98,35 68,57 79,91 50,70 21,91 32,57 2,35 39,35"
          fill="var(--yellow)"
          stroke="var(--black)"
          stroke-width="3"
        />
      </svg>
      <span class="sticker sticker--1" data-parallax="0.12">AI ✦ EVERY DAY</span>
      <span class="sticker sticker--2" data-parallax="-0.06">0 → 300K USERS</span>
      <span class="sticker sticker--3" data-parallax="0.09">SHIPS, NOT DECKS</span>
      <span class="sticker sticker--4" data-parallax="-0.1">10+ YRS</span>

      <div class="hero-kicker reveal">
        <span class="dot"></span>
        Dubai-based · Working worldwide · Taking new clients
      </div>
      <h1 class="reveal">
        I turn <span class="highlight highlight--pink">tech chaos</span> into{" "}
        <span class="highlight highlight--cyan">business</span>{" "}
        <span class="highlight highlight--cyan">results</span>
      </h1>
      <p class="hero-sub reveal">
        Your developers speak in sprints and stack traces. Your board speaks in revenue and risk.
        I speak both, fluently. AI, automation, product, delivery and data, from
        someone who's shipped 30+ products and still builds every day.
      </p>
      <div class="hero-ctas reveal">
        <a href={consultationUrl} class="btn btn--pink btn--big" target="_blank" rel="noopener noreferrer">Book a consult →</a>
        <a href={emailUrl} class="btn btn--big">Contact me</a>
        <a href="#services" class="btn btn--big">See what I do</a>
      </div>
    </div>
  </section>

  <!-- MARQUEE -->
  <div class="marquee" aria-hidden="true">
    <div class="marquee-track">
      {[0, 1].map(() => (
        <>
          {marqueeItems.map((item) => (
            <>
              <span>{item}</span>
              <span class="star-sep">✦</span>
            </>
          ))}
        </>
      ))}
    </div>
  </div>

  <!-- STATS -->
  <section id="stats">
    <div class="wrap">
      <div class="stats-grid stagger">
        <div class="stat-card">
          <span class="stat-number"><span data-count="10" data-suffix="+">0</span></span>
          <span class="stat-label">years in tech</span>
        </div>
        <div class="stat-card">
          <span class="stat-number"><span data-count="30" data-suffix="+">0</span></span>
          <span class="stat-label">products shipped</span>
        </div>
        <div class="stat-card">
          <span class="stat-number"><span data-count="300" data-suffix="K">0</span></span>
          <span class="stat-label">users scaled to</span>
        </div>
        <div class="stat-card">
          <span class="stat-number"><span data-count="4" data-suffix="">0</span></span>
          <span class="stat-label">continents delivered on</span>
        </div>
      </div>
    </div>
  </section>

  <!-- SERVICES -->
  <section id="services">
    <div class="wrap">
      <span class="section-tag reveal">What I do</span>
      <h2 class="section-title reveal">
        Six ways I make your tech <span class="highlight highlight--yellow">less painful</span>
      </h2>
      <div class="services-grid stagger">
        {services.map((s) => (
          <div class="service-card">
            {s.tag && <span class="corner-tag">{s.tag}</span>}
            <div class="service-icon" style={`background:${s.bg}`}><Icon name={s.icon} size={28} /></div>
            <h3>{s.title}</h3>
            <p>{s.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- BRIDGE -->
  <section class="bridge">
    <div class="wrap">
      <span class="section-tag reveal">The superpower</span>
      <h2 class="section-title reveal">Two languages. One translator.</h2>
      <div class="bridge-cols">
        <div class="speech-card speech-card--biz reveal reveal--left">
          <h3><Icon name="briefcase" size={20} /> Your business says</h3>
          <ul>
            <li>"Can we do this with AI?"</li>
            <li>"Why is it taking so long?"</li>
            <li>"What's the ROI on this?"</li>
            <li>"We need it by Q3."</li>
          </ul>
        </div>
        <div class="bridge-mid reveal reveal--pop">
          <div class="bridge-arrows" aria-hidden="true">⟵ ⟶</div>
          <div class="bridge-me">Me.<br />The translator.</div>
          <div class="bridge-arrows" aria-hidden="true">⟵ ⟶</div>
        </div>
        <div class="speech-card speech-card--dev reveal reveal--right">
          <h3><Icon name="terminal" size={20} /> Your devs say</h3>
          <ul>
            <li>"The scope keeps changing."</li>
            <li>"That's technical debt."</li>
            <li>"It works on my machine."</li>
            <li>"We need to refactor first."</li>
          </ul>
        </div>
      </div>
      <p class="bridge-note reveal">
        Ten years of sitting exactly in the middle, writing the user stories developers
        actually want to build, and the exec reports boards actually want to read. Nothing
        lost in translation, nothing shipped late because two rooms couldn't understand each other.
      </p>
    </div>
  </section>

  <!-- WORK -->
  <section id="work">
    <div class="wrap">
      <span class="section-tag reveal">Receipts</span>
      <h2 class="section-title reveal">
        Proof I <span class="highlight highlight--lime">actually deliver</span>
      </h2>
      <div class="work-list stagger">
        {work.map((w) =>
          w.href ? (
            <a class="work-card" href={w.href}>
              <div class="work-num">{w.num}</div>
              <div>
                <h3>{w.title}</h3>
                <p>{w.desc}</p>
              </div>
              <span class="work-tag">{w.tag}</span>
            </a>
          ) : (
            <div class="work-card">
              <div class="work-num">{w.num}</div>
              <div>
                <h3>{w.title}</h3>
                <p>{w.desc}</p>
              </div>
              <span class="work-tag">{w.tag}</span>
            </div>
          )
        )}
      </div>
      <p class="work-more reveal">
        <a href="/portfolio" class="btn btn--big">See the portfolio →</a>
      </p>
    </div>
  </section>

  <!-- TESTIMONIALS -->
  <section class="quotes" id="quotes">
    <div class="wrap">
      <span class="section-tag reveal">They said it</span>
      <h2 class="section-title reveal">
        Not just <span class="highlight highlight--cyan">me talking</span>
      </h2>
      <div class="quotes-grid">
        {testimonials.map((t) => (
          <figure class="quote-card">
            <blockquote>“{t.quote}”</blockquote>
            <figcaption>
              <strong>{t.name}</strong>
              <span>{t.title}</span>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- MARQUEE 2 -->
  <div class="marquee marquee--flip" aria-hidden="true">
    <div class="marquee-track">
      {[0, 1].map(() => (
        <>
          {["Less jargon", "More shipping", "Fewer meetings", "Better products", "Happier devs", "Clearer roadmaps"].map(
            (item) => (
              <>
                <span>{item}</span>
                <span class="star-sep">✦</span>
              </>
            )
          )}
        </>
      ))}
    </div>
  </div>

  <!-- TOOLS -->
  <section class="tools" id="tools">
    <div class="wrap">
      <span class="section-tag reveal">Tools</span>
      <h2 class="section-title reveal">
        Things I <span class="highlight highlight--yellow">built to use</span>
      </h2>
      <p class="hero-sub reveal" style="margin-top: 0;">
        Open-source skills, agents and utilities. More will land here as I ship them.
      </p>
      <div class="blog-grid stagger">
        {tools.map((t) => (
          <a class="blog-card" href={t.href} target="_blank" rel="noopener noreferrer">
            <div class="blog-card-top">
              <span class="blog-icon"><Icon name={t.icon} size={40} /></span>
              <span class="read-time">{t.tag}</span>
            </div>
            <div class="blog-card-body">
              <h3>{t.title}</h3>
              <p>{t.desc}</p>
              <span class="card-cta">{t.cta}</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  {posts.length > 0 && (
    <section class="blog" id="blog">
      <div class="wrap">
        <span class="section-tag reveal">The blog</span>
        <h2 class="section-title reveal">Thoughts, unfiltered</h2>
        <div class="blog-grid stagger">
          {posts.map((p) => (
            <a class="blog-card" href={p.href}>
              <div class="blog-card-top">
                <span class="blog-icon"><Icon name={p.icon} size={40} /></span>
                <span class="read-time">{p.time}</span>
              </div>
              <div class="blog-card-body">
                <h3>{p.title}</h3>
                <p>{p.desc}</p>
                <span class="card-cta">Read it →</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- NEWSLETTER -->
  <section class="newsletter" id="newsletter">
    <div class="wrap">
      <span class="section-tag reveal">The newsletter</span>
      <h2 class="section-title reveal">
        Straight talk, <span class="highlight highlight--pink">in your inbox</span>
      </h2>
      <p class="cta-sub reveal">
        No drip sequences. I'll send something when I have something worth sending.
      </p>
      <div class="reveal reveal--pop">
        <NewsletterForm />
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta" id="contact">
    <div class="wrap">
      <h2 class="section-title reveal">
        Got a tech problem?<br />
        <span class="highlight highlight--pink">Let's fix it.</span>
      </h2>
      <p class="cta-sub reveal">
        Whether it's an AI idea you can't scope, a delivery that's gone sideways, or a
        dev team that needs a leader who gets it. The first chat is free and jargon-free.
      </p>
      <div class="hero-ctas reveal reveal--pop">
        <a href={consultationUrl} class="btn btn--pink btn--big" target="_blank" rel="noopener noreferrer">
          Book a consult ✦
        </a>
        <a href={emailUrl} class="btn btn--big">Contact me</a>
      </div>
    </div>
  </section>
</Layout>
